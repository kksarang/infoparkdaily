{
  "name": "infoparkdaily-local",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --experimental-strip-types services/resume-api/server.ts",
    "check": "tsc --noEmit && node --check js/resume-builder/app.js && node --check js/resume-builder/render.js && node --check js/resume-builder/catalog.js && node --check js/resume-builder/firebase-config.js && node --check js/resume-builder/cloud.js",
    "build:cloud": "esbuild js/resume-builder/cloud.js --bundle --minify --format=esm --outfile=js/resume-builder/cloud.bundle.js --external:./catalog.js --external:./schema.js --external:./firebase-config.js",
    "build:saved": "esbuild js/saved-jobs-cloud.js --bundle --minify --format=esm --outfile=js/saved-jobs-cloud.bundle.js",
    "build:analytics": "esbuild analytics/firebase-bridge.js --bundle --minify --format=esm --outfile=analytics/firebase-bridge.bundle.js --external:./src/config.js --external:../js/resume-builder/firebase-config.js",
    "test": "node --experimental-strip-types --test tests/resume-builder/*.test.ts",
    "resume:fixtures": "node --experimental-strip-types scripts/resume-fixtures.ts",
    "build:community": "node scripts/build-community.mjs",
    "test:community": "node --test --test-concurrency=1 tests/infoparkdaily/security.test.mjs tests/infoparkdaily/hiring.test.mjs",
    "build:journey": "node scripts/interview-journey/build.mjs",
    "build:learning": "node scripts/learning/build.mjs",
    "test:pdf": "node tests/resume-builder/pdf-export.check.mjs"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2"
  }
}
