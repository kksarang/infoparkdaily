# Local only. The server refuses NODE_ENV=production and Razorpay live keys.
PORT=8000
RESUME_PAYMENT_MODE=local
# Optional: use a local Chrome executable if no Playwright browser is installed.
# RESUME_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# To exercise the real Razorpay TEST gateway, set RESUME_PAYMENT_MODE=razorpay_test
# and supply these in your process environment:
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Future production integration; not consumed by the local SQLite adapter:
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
